# Merge reviewed values into the existing private .env.flow or secret manager.
# This file does not create keys, authorize sources, approve MCP or install Skills.
FLOW_VIDEO_ENABLED=false
# Set exact existing workspace IDs for a pilot. Empty + enabled=true is global;
# do not enable globally before completing the scoped rollout checks.
FLOW_VIDEO_WORKSPACES=
VIDEO_SERVICE_TOKEN=
VIDEO_MAX_BYTES=2147483648
VIDEO_MIN_FREE_BYTES=268435456
VIDEO_MIN_FREE_RATIO=0.05
VIDEO_MAX_TEMP_BYTES=4294967296
# Optional container path, only after an operator supplies reviewed read-only
# route and token-file mounts; empty means no credential-ref aliases.
DTK_CREDENTIAL_ROUTES_FILE=
# Use a least-privilege account for the host bucket's authorized video prefixes.
VIDEO_OBJECT_ACCESS_KEY=
VIDEO_OBJECT_SECRET_KEY=
# Static service transport binding only; workspace delegation/schema approval
# remain required. Fill exact endpoint, identity, audience and pinned addresses.
FLOW_TRUSTED_VIDEO_MCP_SERVICES=[]
FLOW_MODEL_GATEWAY_SUPPORTS_VISION=false
VIDEO_MODEL_ENABLED=false
# DTK is separately deployed from the source/digest in the provider lock. This
# overlay deliberately does not pull/run an unconfigured provider automatically.
DTK_ENABLED=false
DTK_URL=
DTK_SERVICE_TOKEN=
DTK_TENANT_ID=
DTK_WORKSPACE_ID=
# Existing host ASR/OCR tokens remain separate from the DTK key and platform Cookie.
ASR_ENABLED=false
ASR_SERVICE_TOKEN=
OCR_ENABLED=false
OCR_SERVICE_TOKEN=
VIDEO_ASR_MODEL_HOST_DIR=./.local/models/asr
# Independent deletion authority. Initialize ONLY a fresh, empty journal once;
# never regenerate on missing/corrupt history or as part of database restore.
VIDEO_DELETION_JOURNAL_VOLUME=weavesense-video-deletion-journal
VIDEO_DELETION_JOURNAL_ID=
VIDEO_DELETION_JOURNAL_KEY=
# Verified digest references required when building the optional backup image.
# No fabricated pins and no implicit image publication.
VIDEO_BACKUP_NODE_IMAGE=
VIDEO_BACKUP_POSTGRES_IMAGE=
VIDEO_BACKUP_MC_IMAGE=
VIDEO_BACKUP_LOCAL_IMAGE=weavesense-video-backup:local
# Required embedding profiles fail closed until model and positive host price
# are configured. Zero price here is NOT an assertion that embedding is free.
FLOW_MODEL_GATEWAY_EMBEDDING_MODEL=
FLOW_MODEL_GATEWAY_EMBEDDING_MICRO_PER_1K_TOKENS=0
FLOW_MODEL_GATEWAY_EMBEDDING_DIMENSIONS=0
