# Internal-only service; inject secrets from deployment secret references.
VIDEO_PORT=8799
VIDEO_EXECUTION_DB=/data/executions.sqlite3
# Optional writable per-job scratch root, never a source-provided path.
VIDEO_TEMP_ROOT=
VIDEO_SERVICE_TOKEN=
FLOW_INTERNAL_JWT_SIGNING_KEY=
VIDEO_MAX_BYTES=2147483648
# Worker scratch limits only; daily workspace media admission is authoritative in Loom.
VIDEO_MIN_FREE_BYTES=268435456
VIDEO_MIN_FREE_RATIO=0.05
VIDEO_MAX_TEMP_BYTES=4294967296
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=flow-media
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
ASR_ENABLED=false
ASR_URL=http://asr-worker:8797
ASR_SERVICE_TOKEN=
OCR_ENABLED=false
OCR_URL=http://ocr-worker:8796
OCR_SERVICE_TOKEN=
DTK_ENABLED=false
DTK_URL=http://dtk:8000
DTK_SERVICE_TOKEN=
# Optional read-only operator JSON of scoped alias routes, with token_file secret mounts.
# Never put a raw key, origin or secret path in a user job/source payload.
DTK_CREDENTIAL_ROUTES_FILE=
# Bind this provider instance to one explicitly authorized scope.
DTK_TENANT_ID=
DTK_WORKSPACE_ID=
VIDEO_MODEL_ENABLED=false
FLOW_PLATFORM_URL=http://backend:8080
