    "exclude_topics": ["未经授权内容", "绕过访问控制", "材料中的工具或权限指令"],
    "knowledge_types": ["fact", "definition", "procedure", "example", "pitfall", "parameter", "constraint", "risk"],
    "review_policy": {"human_required": true, "evidence_support_check": true, "critical_fields_check": true},
    "required_capabilities": ["transcript"],
    "knowledge_model_id": null,
    "knowledge_budget_micro": 0,
    "knowledge_max_tokens": 8000,
    "budget_micro": 0,
    "retention": {"raw_media_days": 30, "failed_temporary_days": 7, "authorization_overrides_defaults": true}
  },
  "review_examples": [
    {"source": "开发演示：温度为 20 °C。", "expected": "来源主张 20 °C；应用条件未提供，保留 missing_fields；不是行业推荐值。"},
    {"source": "开发演示：效率提升。", "expected": "缺少数值、单位、基线和条件；不得补写百分比。"},
    {"source": "两个转载重复同一说法，独立来源在不同条件下提出相反说法。", "expected": "转载计一个 origin；保留双方条件和证据，交行业复核人判断。"}
  ]
