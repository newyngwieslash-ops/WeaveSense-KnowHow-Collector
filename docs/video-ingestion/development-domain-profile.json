{
  "fixture_only": true,
  "not_a_confirmed_industry_profile": true,
  "name": "开发样例：通用证据研究",
  "config": {
    "domain": "general-research-development-only",
    "questions": ["材料实际声明了什么？", "哪些参数、单位或适用条件仍缺失？", "是否存在同源转载或不同条件下的冲突？"],
    "terms": [{"term": "来源主张", "aliases": ["source statement"], "meaning": "作者在材料中的断言，不自动等同已验证事实"}],
